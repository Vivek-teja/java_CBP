{
  "name": "TrafficManagementSemanticModel",
  "compatibilityLevel": 1550,
  "model": {
    "culture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "simulation_runs",
        "columns": [
          {
            "name": "run_id",
            "dataType": "int64",
            "sourceColumn": "run_id",
            "summarizeBy": "none"
          },
          {
            "name": "start_time",
            "dataType": "dateTime",
            "sourceColumn": "start_time",
            "summarizeBy": "sum"
          },
          {
            "name": "end_time",
            "dataType": "dateTime",
            "sourceColumn": "end_time",
            "summarizeBy": "sum"
          },
          {
            "name": "selected_strategy",
            "dataType": "string",
            "sourceColumn": "selected_strategy",
            "summarizeBy": "none"
          },
          {
            "name": "selected_speed",
            "dataType": "double",
            "sourceColumn": "selected_speed",
            "summarizeBy": "sum"
          },
          {
            "name": "simulation_status",
            "dataType": "string",
            "sourceColumn": "simulation_status",
            "summarizeBy": "none"
          },
          {
            "name": "scenario_id",
            "dataType": "string",
            "sourceColumn": "scenario_id",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "simulation_runs-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = MySQL.Database(\"localhost:3306\", \"traffic_management_db\", [ReturnSingleDatabase=true]),",
                "    dbo_Table = Source{[Schema=\"traffic_management_db\",Item=\"simulation_runs\"]}[Data]",
                "in",
                "    dbo_Table"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Simulation Runs",
            "expression": "COUNTROWS('simulation_runs')",
            "formatString": "#,##0"
          }
        ]
      },
      {
        "name": "roads",
        "columns": [
