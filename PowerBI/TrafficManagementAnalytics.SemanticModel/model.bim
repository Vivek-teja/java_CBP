          },
          {
            "name": "road_id",
            "dataType": "int64",
            "sourceColumn": "road_id",
            "summarizeBy": "sum"
          },
          {
            "name": "lane_name",
            "dataType": "string",
            "sourceColumn": "lane_name",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "lanes-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = MySQL.Database(\"localhost:3306\", \"traffic_management_db\", [ReturnSingleDatabase=true]),",
                "    dbo_Table = Source{[Schema=\"traffic_management_db\",Item=\"lanes\"]}[Data]",
                "in",
                "    dbo_Table"
              ]
            }
          }
        ]
      },
      {
        "name": "vehicles",
        "columns": [
          {
            "name": "vehicle_id",
            "dataType": "int64",
            "sourceColumn": "vehicle_id",
            "summarizeBy": "none"
          },
          {
            "name": "vehicle_number",
            "dataType": "string",
            "sourceColumn": "vehicle_number",
            "summarizeBy": "none"
          },
          {
            "name": "run_id",
            "dataType": "int64",
            "sourceColumn": "run_id",
            "summarizeBy": "sum"
          },
          {
            "name": "lane_id",
            "dataType": "int64",
            "sourceColumn": "lane_id",
            "summarizeBy": "sum"
          },
          {
            "name": "vehicle_type",
            "dataType": "string",
            "sourceColumn": "vehicle_type",
            "summarizeBy": "none"
          },
          {
            "name": "is_emergency",
            "dataType": "int64",
            "sourceColumn": "is_emergency",
            "summarizeBy": "sum"
          },
          {
            "name": "arrival_time",
            "dataType": "dateTime",
            "sourceColumn": "arrival_time",
            "summarizeBy": "sum"
          },
          {
            "name": "intersection_entry_time",
            "dataType": "dateTime",
            "sourceColumn": "intersection_entry_time",
            "summarizeBy": "sum"
          },
          {
            "name": "intersection_exit_time",
            "dataType": "dateTime",
            "sourceColumn": "intersection_exit_time",
            "summarizeBy": "sum"
          },
          {
            "name": "vehicle_speed",
            "dataType": "double",
            "sourceColumn": "vehicle_speed",
            "summarizeBy": "sum"
          },
          {
            "name": "current_status",
            "dataType": "string",
            "sourceColumn": "current_status",
            "summarizeBy": "none"
          },
          {
            "name": "current_position",
            "dataType": "double",
            "sourceColumn": "current_position",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "vehicles-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = MySQL.Database(\"localhost:3306\", \"traffic_management_db\", [ReturnSingleDatabase=true]),",
                "    dbo_Table = Source{[Schema=\"traffic_management_db\",Item=\"vehicles\"]}[Data]",
                "in",
                "    dbo_Table"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Vehicles",
            "expression": "COUNTROWS('vehicles')",
            "formatString": "#,##0"
          },
          {
            "name": "Waiting Vehicles",
            "expression": "CALCULATE(COUNTROWS('vehicles'), 'vehicles'[current_status] = \"WAITING\")",
            "formatString": "#,##0"
          },
          {
            "name": "In Intersection Vehicles",
            "expression": "CALCULATE(COUNTROWS('vehicles'), 'vehicles'[current_status] = \"ENTERED_INTERSECTION\")",
            "formatString": "#,##0"
          },
          {
            "name": "Exited Vehicles",
            "expression": "CALCULATE(COUNTROWS('vehicles'), 'vehicles'[current_status] = \"EXITED\")",
            "formatString": "#,##0"
          },
          {
            "name": "Emergency Vehicles",
            "expression": "CALCULATE(COUNTROWS('vehicles'), 'vehicles'[is_emergency] = 1)",
            "formatString": "#,##0"
          },
          {
            "name": "Avg Vehicle Speed",
            "expression": "AVERAGE('vehicles'[vehicle_speed])",
            "formatString": "#,##0.0"
          }
        ]
      },
      {
        "name": "traffic_snapshots",
        "columns": [
          {
            "name": "snapshot_id",
            "dataType": "int64",
            "sourceColumn": "snapshot_id",
