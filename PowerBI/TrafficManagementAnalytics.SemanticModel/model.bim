            "dataType": "string",
            "sourceColumn": "road_direction",
            "summarizeBy": "none"
          },
          {
            "name": "lane_id",
            "dataType": "int64",
            "sourceColumn": "lane_id",
            "summarizeBy": "sum"
          },
          {
            "name": "waiting_vehicle_count",
            "dataType": "int64",
            "sourceColumn": "waiting_vehicle_count",
            "summarizeBy": "sum"
          },
          {
            "name": "queue_length",
            "dataType": "double",
            "sourceColumn": "queue_length",
            "summarizeBy": "sum"
          },
          {
            "name": "signal_state",
            "dataType": "string",
            "sourceColumn": "signal_state",
            "summarizeBy": "none"
          },
          {
            "name": "active_phase",
            "dataType": "string",
            "sourceColumn": "active_phase",
            "summarizeBy": "none"
          },
          {
            "name": "allocated_green_seconds",
            "dataType": "int64",
            "sourceColumn": "allocated_green_seconds",
            "summarizeBy": "sum"
          },
          {
            "name": "remaining_seconds",
            "dataType": "int64",
            "sourceColumn": "remaining_seconds",
            "summarizeBy": "sum"
          },
          {
            "name": "vehicle_throughput",
            "dataType": "int64",
            "sourceColumn": "vehicle_throughput",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "traffic_snapshots-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = MySQL.Database(\"localhost:3306\", \"traffic_management_db\", [ReturnSingleDatabase=true]),",
                "    dbo_Table = Source{[Schema=\"traffic_management_db\",Item=\"traffic_snapshots\"]}[Data]",
                "in",
                "    dbo_Table"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Peak Queue Length",
            "expression": "MAX('traffic_snapshots'[queue_length])",
            "formatString": "#,##0.0"
          },
          {
            "name": "Avg Waiting Count",
            "expression": "AVERAGE('traffic_snapshots'[waiting_vehicle_count])",
            "formatString": "#,##0.0"
          },
          {
            "name": "Avg Green Seconds",
            "expression": "AVERAGE('traffic_snapshots'[allocated_green_seconds])",
            "formatString": "#,##0.0"
          },
          {
            "name": "Total Vehicle Throughput",
            "expression": "MAX('traffic_snapshots'[vehicle_throughput])",
            "formatString": "#,##0"
          }
        ]
      },
      {
