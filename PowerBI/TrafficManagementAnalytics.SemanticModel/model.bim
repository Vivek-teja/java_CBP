            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "roads-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = MySQL.Database(\"localhost:3306\", \"traffic_management_db\", [ReturnSingleDatabase=true]),",
                "    dbo_Table = Source{[Schema=\"traffic_management_db\",Item=\"roads\"]}[Data]",
                "in",
                "    dbo_Table"
              ]
            }
          }
        ]
      },
      {
        "name": "lanes",
        "columns": [
          {
            "name": "lane_id",
            "dataType": "int64",
